# Project specific exclusions
# Do not include the local sqlite database in the container image
phishguard.db
phishguard.db-journal
phishguard.db-wal
phishguard.db-shm

# We don't need the extension source code in the backend container
extension/

# We don't need the local test files or docs in the container
tests/
docs/
