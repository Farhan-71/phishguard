# Copy to .env and fill in, or export these directly. Generate real keys with:
#   python scripts/gen_keys.py

# dev = ephemeral keys are auto-generated and logged if unset; anything else requires
# PHISHGUARD_SCAN_KEYS / PHISHGUARD_ADMIN_KEYS to be set.
PHISHGUARD_ENV=dev

# Comma-separated API keys, 16+ chars each.
PHISHGUARD_SCAN_KEYS=
PHISHGUARD_ADMIN_KEYS=

# SQLite by default; any SQLAlchemy URL works (postgresql+psycopg://... in production).
DATABASE_URL=sqlite:///phishguard.db

# Per-key rate limits (requests/minute) and a pre-auth per-address limit.
PHISHGUARD_SCAN_RATE_LIMIT=60
PHISHGUARD_ADMIN_RATE_LIMIT=120
PHISHGUARD_IP_RATE_LIMIT=240

# DNS/RDAP/TLS checks. Disable for offline dev or CI (falls back to rules + ML only).
PHISHGUARD_NETWORK_CHECKS=true
PHISHGUARD_NETWORK_TIMEOUT=2.5
PHISHGUARD_SCAN_DEADLINE=4.0

# Comma-separated origins allowed to call the API from a browser (leave blank to disable CORS;
# the bundled dashboard is served same-origin and does not need this).
PHISHGUARD_CORS_ORIGINS=

# Prior-shift correction: assumed real-world share of scanned URLs that are phishing.
# Tune with ml/evaluation/external_check.py before changing from the default.
PHISHGUARD_ASSUMED_PREVALENCE=0.3

PHISHGUARD_MODEL_PATH=ml/models/model.joblib
PHISHGUARD_METRICS_PATH=ml/models/metrics.json
PHISHGUARD_INTEL_TTL_DAYS=30

# Salt for hashing client addresses before they touch logs/DB. Auto-generated if unset,
# but set a fixed value in production so security-event actor hashes stay comparable across restarts.
PHISHGUARD_LOG_SALT=
